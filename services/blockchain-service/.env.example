# Blockchain Service - Base Sepolia Testnet Configuration
# Copy to .env.local and fill in REAL values.
# NEVER commit a file containing real private keys to git.

BLOCKCHAIN_MODE=REAL_TESTNET
TESTNET_ENABLED=true
BLOCKCHAIN_NETWORK=base-sepolia
BLOCKCHAIN_CHAIN_ID=84532
BLOCKCHAIN_RPC_URL=https://sepolia.base.org
BLOCKCHAIN_TOKEN_CONTRACT=0x036CbD53842c5426634e7929541eC2318f3dCF7e
BLOCKCHAIN_TOKEN_SYMBOL=USDC
BLOCKCHAIN_TOKEN_DECIMALS=6
BLOCKCHAIN_EXPLORER_BASE_URL=https://sepolia.basescan.org
BLOCKCHAIN_CONFIRMATIONS_REQUIRED=1

# Wallet — placeholders only. NEVER put real values in .env.example.
BLOCKCHAIN_WALLET_ADDRESS=0xYOUR_WALLET_ADDRESS_HERE
BLOCKCHAIN_WALLET_PRIVATE_KEY=YOUR_PRIVATE_KEY_NEVER_COMMIT_THIS
