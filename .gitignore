target/
*.class
*.jar
*.war
*.ipr
*.iws
*.factorypath
.classpath
.project
.settings/

# Maven wrapper cache (downloaded by mvnw, not committed)
services/.m2/

# IDE
.vscode/settings.local.json
.idea/
*.iml

# OS
.DS_Store
Thumbs.db

# AWS
.aws-sam/

# CDK
cdk.out/

