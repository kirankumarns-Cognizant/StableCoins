# ============================================================
# Stablecoin Intelligent Payment Orchestration POC
# Environment Configuration Template
#
# Copy to .env for local development.
# NEVER commit .env to source control.
# In AWS: use Secrets Manager and ECS task environment variables.
# ============================================================

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
APP_ENV=local
SPRING_PROFILES_ACTIVE=local

# ------------------------------------------------------------
# Database (Aurora PostgreSQL)
# Local application: Docker Compose PostgreSQL; tests use isolated Testcontainers.
# AWS: use Secrets Manager for credentials; set DB_PASSWORD_SECRET.
# ------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stablecoin_poc
DB_USERNAME=stablecoin
DB_PASSWORD=CHANGE_ME_LOCAL_ONLY
DB_PASSWORD_SECRET=
DB_POOL_SIZE=10

# ------------------------------------------------------------
# Blockchain
# BLOCKCHAIN_MODE controls the adapter used:
#   MOCK          — no network calls (default for test/local)
#   REAL_TESTNET  — connects to a real public testnet
#
# Real testnet requires BOTH:
#   BLOCKCHAIN_MODE=REAL_TESTNET
#   TESTNET_ENABLED=true
#
# Token configuration (Base Sepolia USDC):
#   Contract address is obtained from Circle's testnet deployment.
#   Never hardcode — always use these environment variables.
# ------------------------------------------------------------
BLOCKCHAIN_MODE=MOCK
TESTNET_ENABLED=false
BLOCKCHAIN_NETWORK=base-sepolia
BLOCKCHAIN_CHAIN_ID=84532
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_TOKEN_CONTRACT=0x036CbD53842c5426634e7929541eC2318f3dCF7e
BLOCKCHAIN_TOKEN_SYMBOL=USDC
BLOCKCHAIN_TOKEN_DECIMALS=6
BLOCKCHAIN_WALLET_SECRET_NAME=
BLOCKCHAIN_EXPLORER_URL=https://sepolia.basescan.org

# Reserved fallback metadata; no automatic switching is implemented.
# To select Ethereum Sepolia, replace the primary BLOCKCHAIN_* tuple explicitly.
BLOCKCHAIN_FALLBACK_NETWORK=ethereum-sepolia
BLOCKCHAIN_FALLBACK_CHAIN_ID=11155111
BLOCKCHAIN_FALLBACK_RPC_URL=
BLOCKCHAIN_FALLBACK_TOKEN_CONTRACT=
BLOCKCHAIN_FALLBACK_EXPLORER_URL=https://sepolia.etherscan.io

# ------------------------------------------------------------
# AWS
# ------------------------------------------------------------
AWS_REGION=us-east-1

# EventBridge
EVENTBRIDGE_BUS_NAME=stablecoin-payment-bus

# SQS queue and DLQ names
# Queue names are shared by listeners, local publishers, initialization, and CDK.
SQS_PAYMENT_CREATED_QUEUE_NAME=stablecoin-payment-created-queue
SQS_COMPLIANCE_COMPLETED_QUEUE_NAME=stablecoin-compliance-completed-queue
SQS_BLOCKCHAIN_SUBMITTED_QUEUE_NAME=stablecoin-blockchain-submitted-queue
SQS_BLOCKCHAIN_CONFIRMED_QUEUE_NAME=stablecoin-blockchain-confirmed-queue
SQS_PAYMENT_CREATED_DLQ_NAME=stablecoin-payment-created-dlq
SQS_COMPLIANCE_COMPLETED_DLQ_NAME=stablecoin-compliance-completed-dlq

# ------------------------------------------------------------
# Cognito (Auth)
# Cognito JWT validation is implemented. Supply issuer, HTTPS JWKS, client and
# server-owned memberships; missing configuration denies protected API access.
# ------------------------------------------------------------
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_ISSUER_URI=
COGNITO_HOSTED_UI_DOMAIN=

# ------------------------------------------------------------
# Service ports (local development)
# ------------------------------------------------------------
PAYMENT_SERVICE_PORT=8080
COMPLIANCE_QUOTE_SERVICE_PORT=8081
BLOCKCHAIN_SERVICE_PORT=8082
SETTLEMENT_LEDGER_SERVICE_PORT=8083
RECONCILIATION_SERVICE_PORT=8084
VISA_SIMULATOR_PORT=8086

# ------------------------------------------------------------
# Visa Simulator
# VISA_MODE controls the adapter used:
#   SIMULATOR — VisaSimulatorAdapter (default)
#   REAL      — future VisaDirectAdapter (not implemented in V1)
# ------------------------------------------------------------
# VISA_MODE is reserved; the current implementation is always SIMULATOR.
# VISA_SIMULATOR_INTERNAL_URL=http://visa-simulator:8086 (Compose default)

# ------------------------------------------------------------
# LocalStack (local development only)
# ------------------------------------------------------------
# Host Java processes: localhost. For Compose use http://localstack:4566 or leave unset.
# Blank for Compose: its container endpoint defaults to http://localstack:4566.
# For host Java only, explicitly set http://localhost:4566 in that process.
LOCALSTACK_URL=
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=JSON

# Shared configuration: backend override file (absolute file: URI); leave unset to use packaged defaults.
# CONNECTIONS_CONFIG=file:C:/secure-config/connections.properties
# Never serve this backend file to the browser.
IDENTITY_PROVIDER=COGNITO
# IDENTITY_ISSUER_URI= (optional override of COGNITO_ISSUER_URI)
IDENTITY_JWK_SET_URI=
IDENTITY_AUDIENCE=
# Distinct confidential Cognito client for internal calls; never the browser client.
IDENTITY_SERVICE_CLIENT_ID=
IDENTITY_SERVICE_SCOPE=stablecoins/internal
# IDENTITY_CLIENT_ID= (optional override of COGNITO_APP_CLIENT_ID)
IDENTITY_AUTHORIZATION_URI=
IDENTITY_TOKEN_URI=
IDENTITY_REDIRECT_URI=http://localhost:5173/auth/callback
IDENTITY_SCOPES=openid profile
PUBLIC_API_BASE_URL=/api/v1

# Future AI integration; secret name only, never put the API key in the shared file.
# OPENAI + SECRET_BEARER: direct OpenAI key from Secrets Manager.
# BEDROCK + AWS_SIGV4: ECS task role; AI_API_KEY_SECRET_NAME may be blank.
AI_PROVIDER=OPENAI
AI_AUTH_MODE=SECRET_BEARER
AI_REGION=us-east-1
AI_BASE_URL=https://api.openai.com/v1
# Bedrock example (verify exact model/Region/account access before enabling):
# AI_BASE_URL=https://bedrock-runtime.us-east-2.amazonaws.com/openai/v1
# AI_MODEL=openai.gpt-5.6-terra
AI_MODEL=
AI_API_KEY_SECRET_NAME=
AI_TIMEOUT_MS=30000

BLOCKCHAIN_RPC_CONNECT_TIMEOUT_MS=10000
BLOCKCHAIN_RPC_READ_TIMEOUT_MS=30000
BLOCKCHAIN_CONFIRMATIONS_REQUIRED=1

# Compose mount override (host path). Backend CONNECTIONS_CONFIG is set to the container mount.
# CONNECTIONS_CONFIG_FILE=./services/config/connections.properties
# Bare Java processes do not auto-read .env. Compose forwards only its explicit allowlist.

# Optional deterministic assessment overrides; defaults live in services/config/connections.properties.
# Change ROUTING_ASSESSMENT_VERSION when changing thresholds or ranking semantics.
# ROUTING_ASSESSMENT_VERSION=
# ROUTING_MAXIMUM_EVIDENCE_AGE=
# ROUTING_HISTORICAL_WINDOW=
# ROUTING_MINIMUM_SAMPLE_SIZE=
# ROUTING_LATENCY_PERCENTILE=
# ROUTING_MINIMUM_SUCCESS_RATE=
# ROUTING_MAXIMUM_FRAUD_SCORE=
# ROUTING_MAXIMUM_PRICE_DEVIATION_BPS=
# ROUTING_MAXIMUM_CANDIDATES=
# ROUTING_MAXIMUM_OBSERVATIONS=

# Optional treasury and simulated-provider overrides (server only).
# BLOCKCHAIN_RESERVATION_TTL=
# BLOCKCHAIN_READINESS_TTL=
# BLOCKCHAIN_GAS_LIMIT_MULTIPLIER=
# BLOCKCHAIN_GAS_PRICE_MULTIPLIER=
# BLOCKCHAIN_ADDITIONAL_GAS_RESERVE_ETH=
# BLOCKCHAIN_EXECUTION_API_ENABLED=
# VISA_SIMULATOR_ALLOWED_PROVIDER_IDS=
# VISA_SIMULATOR_RESERVATION_TTL=

# Cognito access-token validation; configure issuer, HTTPS JWKS and app client together.
IDENTITY_HTTP_TIMEOUT_MS=5000
# Customer membership and roles belong in the server-only CONNECTIONS_CONFIG file.

SQS_ROUTING_DECISIONS_QUEUE_NAME=stablecoin-routing-decisions-queue
SQS_ROUTING_DECISIONS_DLQ_NAME=stablecoin-routing-decisions-dlq

# Read-only OpenAI routing agent (requires configured customer membership/policy).
# Never place an API key here; AI_API_KEY_SECRET_NAME names a Secrets Manager secret.
# Set exact AI_MODEL and verify its current pricing/account access before enabling.
ROUTING_AGENT_ENABLED=false
# ROUTING_AGENT_ALLOWED_CUSTOMER_IDS=
# ROUTING_AGENT_MAXIMUM_ROUNDS=12
# ROUTING_AGENT_MAXIMUM_TOOL_CALLS=24
# ROUTING_AGENT_MAXIMUM_OUTPUT_TOKENS=4096
# ROUTING_AGENT_MAXIMUM_TOTAL_TOKENS=250000
# ROUTING_AGENT_MAXIMUM_REQUEST_BYTES=65536
# ROUTING_AGENT_MAXIMUM_RESPONSE_BYTES=131072
# ROUTING_AGENT_MAXIMUM_CONCURRENT_RUNS=2
# ROUTING_AGENT_MAXIMUM_RUNS_PER_PAYMENT=10
# ROUTING_AGENT_DEADLINE_MS=90000
# ROUTING_AGENT_MAXIMUM_INFERENCE_COST_USD=1.00
# ROUTING_AGENT_INPUT_USD_PER_MILLION=0
# ROUTING_AGENT_OUTPUT_USD_PER_MILLION=0

# Accepted ADR-015. Manual writes require an independently protected internal boundary.
LEDGER_ACCOUNTING_POLICY_VERSION=adr015-v1
LEDGER_MANUAL_API_ENABLED=false
# Account overrides use LEDGER_ACCOUNT_<ROLE>; defaults are in shared connections.properties.

# Durable payment flow; enable only with verified identity membership/customer policy.
PAYMENT_FLOW_ENABLED=false
PAYMENT_EXECUTION_ENABLED=false
PAYMENT_FLOW_POLL_MS=3000
PAYMENT_FLOW_PREPARATION_TIMEOUT_SECONDS=120
FLOW_SIMULATION_VERSION=simulation-v1
FLOW_SIMULATION_PROVIDER_IDS=SIMULATED-PROVIDER-A,SIMULATED-PROVIDER-B
FLOW_QUOTE_TTL=PT5M
FLOW_SIMULATED_FEE_USD=2.00
FLOW_SIMULATED_COMPLETED=990
FLOW_SIMULATED_ATTEMPTS=1000
FLOW_SIMULATED_LATENCY_MS=120000
FLOW_SIMULATED_FRAUD_SCORE=10
FLOW_SIMULATED_AVAILABLE=true
FLOW_SIMULATED_ETH_USD_BUDGET=2000
SCHEDULING_POOL_SIZE=4
FLOW_PROVIDER_B_FEE_USD=5.00
FLOW_PROVIDER_B_LATENCY_MS=60000
FLOW_PROVIDER_B_AVAILABLE=true

# Step 8 simulator only. Enable operations only for controlled prefunding/resolution.
FLOW_SIMULATED_FX_USD=1.00
FLOW_SIMULATED_FX_INR=83.00
VISA_SIMULATOR_PAYOUT_SCENARIO=SUCCEEDED
VISA_SIMULATOR_OPERATIONS_ENABLED=false
